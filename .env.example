# Firebase web config (Project settings > Your apps > Web app). Client identifiers; kept out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check on the hosted domain (never add localhost to the key).
VITE_RECAPTCHA_SITE_KEY=
# Optional, localhost only: a registered App Check debug token. Empty = the SDK prints a new one to register.
VITE_APPCHECK_DEBUG_TOKEN=
